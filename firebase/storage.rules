rules_version = '2';
// قواعد تخزين الشواهد (تُستخدم بعد تفعيل Storage).
// تُنسخ إلى: Firebase ← Storage ← Rules ← Publish
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
